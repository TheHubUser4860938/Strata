{
  "exe": "$HOME/Projects/Strata-MAM-cartrige-mod/engine/strata",
  "args": [
    "--pack",
    "$HOME/Projects/Strata-MAM-cartrige-mod/Strata-data/packs/iq3_s",
    "--native",
    "$HOME/Projects/Strata-MAM-cartrige-mod/Strata-data/models/IQ3_S/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00001-of-00002.gguf",
    "--ple-gguf",
    "$HOME/Projects/Strata-MAM-cartrige-mod/Strata-data/models/IQ3_S/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00002-of-00002.gguf",
    "--expert-profile",
    "$HOME/Projects/Strata-MAM-cartrige-mod/data/expert-profile.bin",
    "--expert-cache",
    "auto",
    "--prefill",
    "auto",
    "--spec",
    "4",
    "--mtp",
    "$HOME/Projects/Strata-MAM-cartrige-mod/Strata-data/mtp/rt",
    "--max-context",
    "524288",
    "--rope-scaling",
    "yarn",
    "--rope-scale",
    "2",
    "--kv",
    "k8v4",
    "--vision",
    "--vram-reserve-mib",
    "950",
    "--pcie-frac",
    "0.35",
    "--spec-min-p",
    "0.70",
    "--adapt-every",
    "1",
    "--adapt-swaps",
    "80",
    "--adapt-decay",
    "0.97",
    "--slot-save-path",
    "$HOME/Projects/Strata-MAM-cartrige-mod/Strata-data/sessions-dev"
  ],
  "cwd": "$HOME/Projects/Strata-MAM-cartrige-mod",
  "tokenizer": "$HOME/Projects/Strata-MAM-cartrige-mod/Strata-data/packs/iq3_s/tokenizer",
  "model_name": "qwen3.8-flash-next-iq3_s",
  "log": "$HOME/Projects/Strata-MAM-cartrige-mod/strata-dev.log",
  "lib_dirs": [
    "/opt/cuda/bin",
    "/opt/cuda/lib64"
  ],
  "port": 8005,
  "gpu": 0,
  "gpus_asked": true,
  "draft_vocab": "en",
  "vision": {
    "exe": "$HOME/Projects/Strata-MAM-cartrige-mod/engine/strata-vision",
    "mmproj": "$HOME/Projects/Strata-MAM-cartrige-mod/Strata-data/models/mmproj-Qwen3.8-Flash-Next-BF16.gguf",
    "model": "$HOME/Projects/Strata-MAM-cartrige-mod/Strata-data/models/IQ3_S/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00001-of-00002.gguf",
    "gpu": true,
    "max_tokens": 1024
  },
  "sampling": {
    "temperature": 1.0,
    "top_p": 0.95,
    "top_k": 20,
    "min_p": 0.0
  },
  "reasoning_budget_tokens": 0,
  "idle_unload_s": 700,
  "fit_max_tokens": true
}
